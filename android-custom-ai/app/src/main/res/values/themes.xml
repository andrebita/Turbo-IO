<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TurboIO" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">#0B6E99</item>
        <item name="colorSecondary">#00897B</item>
        <!-- Android 15/16 enforce edge-to-edge for targetSdk 35; keep the classic layout so the action bar,
             bottom navigation and adjustResize (keyboard) behave the same as on Android 8–14. -->
